{{- $email := promptStringOnce . "email" "Git email address" -}}
{{- $name := promptStringOnce . "name" "Git user name" -}}
{{- $personal := promptBoolOnce . "personal" "Is this a personal machine (y/n)" -}}

[data]
    email = {{ $email | quote }}
    name = {{ $name | quote }}
    personal = {{ $personal }}
    work = {{ not $personal }}
